# PostgreSQL (docker-compose uses its own internal value by default)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lazy_clipper
STORAGE_DIR=storage

# YouTube ingestion. In Compose, cookies.txt is mounted at /app/cookies.txt.
# Leave the cookie path configured if the file is absent; ingestion remains
# available for URLs that do not require authentication.
YTDLP_COOKIE_FILE=/app/cookies.txt
YTDLP_JS_RUNTIME=node

# OpenAI-compatible LLM. FreeLLMAPI works by changing these values only.
# This hostname reaches a gateway on the host from Docker Compose.
# For non-Compose development, use http://127.0.0.1:3001/v1 instead.
LLM_BASE_URL=http://host.docker.internal:3001/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-id
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Docker frontend: leave empty to use the same-origin /api proxy.
# Set only for a separate public API origin, then rebuild the frontend image.
VITE_API_BASE_URL=

# Optional processing settings (also passed into the Compose API container)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
TRANSCRIPT_CHUNK_SECONDS=300
TRANSCRIPT_OVERLAP_SECONDS=45
MAX_MOMENTS=10
