# Local non-Compose PostgreSQL. Supply your database password via a local URL
# or DATABASE_PASSWORD_FILE; Compose uses its internal non-superuser connection.
DATABASE_URL=postgresql+psycopg://lazyclipper@localhost:5432/lazy_clipper
STORAGE_DIR=storage

# Required for Compose: the server's trusted Tailscale IPv4 address.
# API and PostgreSQL ports are internal only. Do not use 0.0.0.0 here.
FRONTEND_BIND_ADDRESS=
# Run: python3 scripts/setup_secrets.py
# Existing database volume? Follow README's explicit role/schema upgrades before API startup.
# Local Vite development origins; Compose explicitly disables cross-origin access.
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# YouTube ingestion. In Compose, cookies.txt is mounted at /app/cookies.txt.
# Leave the cookie path configured if the file is absent; ingestion remains
# available for URLs that do not require authentication.
YTDLP_COOKIE_FILE=/app/cookies.txt
YTDLP_JS_RUNTIME=node

# OpenAI-compatible LLM. FreeLLMAPI works by changing these values only.
# This hostname reaches a gateway on the host from Docker Compose.
# For non-Compose development, use http://127.0.0.1:3001/v1 instead.
LLM_BASE_URL=http://host.docker.internal:3001/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-id
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Docker frontend: leave empty to use the same-origin /api proxy.
# Set only for a separate public API origin, then rebuild the frontend image.
VITE_API_BASE_URL=

# Optional processing settings (also passed into the Compose API container)
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
TRANSCRIPT_CHUNK_SECONDS=300
TRANSCRIPT_OVERLAP_SECONDS=45
MAX_MOMENTS=10

# Two active supervised jobs plus this many waiting jobs. Excess POSTs return 429.
MAX_QUEUED_JOBS=4
# Reject unknown/non-finite source duration. Clip maximum may be lowered, not raised above 180.
MAX_SOURCE_SECONDS=7200
MAX_CLIP_SECONDS=180
# Wall-clock budgets start when a worker starts the child, not while waiting.
# Ingestion includes metadata/download, model load, transcription, and analysis.
INGESTION_TIMEOUT_SECONDS=7200
CLIP_TIMEOUT_SECONDS=960
# Reserved inside each job budget so FFmpeg reports its own timeout before the supervisor deadline.
MEDIA_TIMEOUT_MARGIN_SECONDS=30
SUBMISSION_LOCK_TIMEOUT_SECONDS=1
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_SECONDS=10
DATABASE_LOCK_TIMEOUT_SECONDS=3
STORAGE_MAX_BYTES=53687091200
STORAGE_MIN_FREE_BYTES=1073741824
STORAGE_JOB_RESERVE_BYTES=1073741824
