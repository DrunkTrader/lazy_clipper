# PostgreSQL (docker-compose uses its own internal value by default)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lazy_clipper
STORAGE_DIR=storage

# OpenAI-compatible LLM. FreeLLMAPI works by changing these values only.
LLM_BASE_URL=http://127.0.0.1:3001/v1
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-id
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Optional local processing settings
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TRANSCRIPT_CHUNK_SECONDS=300
TRANSCRIPT_OVERLAP_SECONDS=45
MAX_MOMENTS=10
